{
  "permissions": {
    "allow": [
      "Bash(rails:*)",
      "Bash(docker:*)",
      "Bash(sudo rm:*)",
      "Bash(docker-compose build:*)",
      "Bash(git add:*)",
      "Bash(bin/rspec spec/system --format documentation 2>&1)",
      "Bash(bin/rspec --format documentation 2>&1)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Skill(run-ruby-specs)",
      "Bash(bin/rspec spec/models/like_spec.rb spec/models/follow_spec.rb spec/models/comment_spec.rb spec/requests/likes_spec.rb spec/requests/follows_spec.rb spec/requests/comments_spec.rb 2>&1)",
      "Bash(bin/rspec --exclude-pattern \"spec/system/**/*\" 2>&1)",
      "Bash(bin/rspec spec/system/social/ 2>&1)",
      "Bash(bin/rspec 2>&1)",
      "Bash(bin/rspec spec/system/creator/project_images_spec.rb 2>&1)",
      "Bash(bin/rspec spec/models/invitation_spec.rb spec/mailers/invitation_mailer_spec.rb spec/requests/invitations_spec.rb spec/requests/admin/ 2>&1)",
      "Bash(bin/rspec spec/system/admin/ spec/system/invitations_spec.rb 2>&1)",
      "Bash(for id:*)",
      "Bash(do echo:*)",
      "Bash(bin/rspec spec/requests/pages_spec.rb spec/requests/projects_feed_spec.rb spec/models/user_social_links_spec.rb spec/models/project_tag_filter_spec.rb 2>&1)",
      "Bash(bin/rspec spec/models/invitation_spec.rb spec/models/project_tag_filter_spec.rb spec/models/user_social_links_spec.rb spec/requests/pages_spec.rb spec/requests/invitations_spec.rb 2>&1)",
      "Bash(bin/rspec spec/models/product_link_spec.rb spec/models/user_social_links_spec.rb 2>&1)",
      "Bash(bin/rspec spec/models/user_spec.rb spec/models/user_social_links_spec.rb spec/requests/invitations_spec.rb 2>&1)",
      "Bash(bin/rspec spec/system/public/projects_spec.rb:7)"
    ]
  }
}
