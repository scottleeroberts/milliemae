article.flex.flex-col.gap-1 id=dom_id(comment)
  .flex.items-center.gap-2
    span.font-medium.text-sm = comment.user.display_name
    span.text-gray-500.text-xs = "#{time_ago_in_words(comment.created_at)} ago"
    - if comment.destroyable_by?(current_user)
      = button_to project_comment_path(project, comment), method: :delete, class: "ml-auto inline-flex items-center justify-center min-w-8 min-h-8 text-xs text-gray-500 hover:text-red-500 transition-colors", data: { turbo_confirm: "Delete this comment?" }
        | ×
  p.text-sm.text-gray-800 = comment.body
