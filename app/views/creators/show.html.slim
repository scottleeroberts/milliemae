- content_for :title, "#{@creator.display_name} — Sew Twirly"
- content_for :description, "Sewing projects by #{@creator.display_name} on Sew Twirly."

.mb-8
  .flex.items-start.justify-between.gap-4
    .flex.items-start.gap-4
      img.w-16.h-16.rounded-full src=@creator.gravatar_url(size: 128) alt="#{@creator.display_name}'s avatar"
      div
        h1.text-3xl.font-bold = @creator.display_name
        - if @creator.bio.present?
          p.text-gray-600.mt-2.max-w-prose = @creator.bio
        - social_links = { "Instagram" => @creator.instagram, "Etsy" => @creator.etsy, "Pinterest" => @creator.pinterest, "Website" => @creator.website, "Facebook" => @creator.facebook }.select { |_label, url| url.present? }
        - if social_links.any?
          .flex.flex-wrap.gap-2.mt-3
            - social_links.each do |label, url|
              = link_to label, url, target: "_blank", rel: "noopener noreferrer", class: "inline-block text-xs font-medium text-pink-600 bg-pink-50 border border-pink-200 rounded-full px-3 py-1 hover:bg-pink-100 hover:text-pink-700"
    .mt-1
      = render "follows/button", creator: @creator

hr.mb-8

- if @projects.any?
  h2.text-lg.font-semibold.mb-4 Projects
  .grid.grid-cols-1.gap-6 style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));"
    - @projects.each do |project|
      = render "projects/card", project: project
- else
  p.text-gray-400 #{@creator.display_name} hasn't published any projects yet.
