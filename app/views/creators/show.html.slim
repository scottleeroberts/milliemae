- content_for :title, "#{@creator.display_name} — Sew Twirly"
- content_for :description, "Sewing projects by #{@creator.display_name} on Sew Twirly."

.bg-rose-50.rounded-xl.p-8.mb-8.-mx-4
  .flex.flex-col.sm:flex-row.items-center.sm:items-start.gap-6
    img.w-24.h-24.rounded-full.shadow-md.shrink-0 src=@creator.gravatar_url(size: 192) alt="#{@creator.display_name}'s avatar"

    .flex-1.text-center.sm:text-left
      .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-4
        h1.text-3xl.font-bold = @creator.display_name
        = render "follows/button", creator: @creator

      - if @creator.bio.present?
        p.text-gray-600.mt-3.max-w-prose = @creator.bio

      / Stats
      .flex.justify-center.sm:justify-start.gap-6.mt-4
        .text-center
          span.block.text-lg.font-semibold.text-gray-900 = @projects.size
          span.text-xs.text-gray-500 Projects
        .text-center
          span.block.text-lg.font-semibold.text-gray-900 = @creator.followers.size
          span.text-xs.text-gray-500 Followers

      / Social links
      - social_links = { "Instagram" => @creator.instagram, "Etsy" => @creator.etsy, "Pinterest" => @creator.pinterest, "Website" => @creator.website, "Facebook" => @creator.facebook }.select { |_label, url| url.present? }
      - if social_links.any?
        .flex.flex-wrap.justify-center.sm:justify-start.gap-2.mt-4
          - social_links.each do |label, url|
            = link_to label, url, target: "_blank", rel: "noopener noreferrer", class: "inline-block text-xs font-medium text-pink-600 bg-white border border-pink-200 rounded-full px-3 py-1 hover:bg-pink-100 hover:text-pink-700 shadow-sm transition-colors"

hr.mb-8.border-rose-100

- if @projects.any?
  h2.text-lg.font-semibold.mb-4 Projects
  .grid.grid-cols-1.gap-6 style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));"
    - @projects.each do |project|
      = render "projects/card", project: project
- else
  p.text-gray-400 #{@creator.display_name} hasn't published any projects yet.
