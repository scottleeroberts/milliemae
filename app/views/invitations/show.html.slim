- content_for :title, "Create your account — Sew Twirly"

.max-w-md.mx-auto.mt-8
  h1.text-2xl.font-bold.mb-2 Create your creator account
  p.text-gray-600.mb-6
    | You've been invited to join Sew Twirly as a creator.

  = form_with url: accept_invitation_path(@invitation.token), method: :post, class: "space-y-4" do |f|
    div
      = label_tag "user[name]", "Your name", class: "block text-sm font-medium text-gray-700 mb-1"
      = text_field_tag "user[name]", @user.name, class: "w-full border rounded px-3 py-2 text-sm", placeholder: "Jane Smith", autofocus: true
      - if @user.errors[:name].any?
        p.text-red-500.text-xs.mt-1 = @user.errors[:name].first

    div
      = label_tag :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1"
      = text_field_tag :email, @invitation.email, disabled: true, class: "w-full border rounded px-3 py-2 text-sm bg-gray-100 text-gray-500"

    div
      = label_tag "user[password]", "Password", class: "block text-sm font-medium text-gray-700 mb-1"
      = password_field_tag "user[password]", nil, class: "w-full border rounded px-3 py-2 text-sm"
      - if @user.errors[:password].any?
        p.text-red-500.text-xs.mt-1 = @user.errors[:password].first

    div
      = label_tag "user[password_confirmation]", "Confirm password", class: "block text-sm font-medium text-gray-700 mb-1"
      = password_field_tag "user[password_confirmation]", nil, class: "w-full border rounded px-3 py-2 text-sm"
      - if @user.errors[:password_confirmation].any?
        p.text-red-500.text-xs.mt-1 = @user.errors[:password_confirmation].first

    = submit_tag "Create my account", class: "w-full bg-pink-500 text-white py-2 px-4 rounded hover:bg-pink-600 cursor-pointer font-medium text-sm"
