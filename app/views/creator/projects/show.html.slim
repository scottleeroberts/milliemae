- content_for :title, "#{@project.title} — Sew Twirly"

.mb-4
  = link_to "← My Projects", creator_projects_path, class: "text-sm text-gray-500 hover:underline"

.flex.items-start.justify-between.mb-4
  div
    h1.text-3xl.font-bold = @project.title
    p.text-sm.text-gray-500.mt-1
      - if @project.published?
        span.text-green-600 Published ·
        = @project.published_date
      - else
        span.text-yellow-600 Draft
  .flex.gap-2
    = link_to "Edit", edit_creator_project_path(@project), class: "text-sm bg-gray-100 px-3 py-1 rounded hover:bg-gray-200"
    - if @project.published?
      = button_to "Unpublish", unpublish_creator_project_path(@project), method: :patch, class: "text-sm bg-yellow-100 text-yellow-800 px-3 py-1 rounded hover:bg-yellow-200 border-0 cursor-pointer"
    - else
      = button_to "Publish", publish_creator_project_path(@project), method: :patch, class: "text-sm bg-green-100 text-green-800 px-3 py-1 rounded hover:bg-green-200 border-0 cursor-pointer"

- if @project.tags.any?
  .flex.gap-2.mb-6
    - @project.tags.each do |tag|
      span.bg-gray-100.text-gray-700.text-xs.px-2.py-1.rounded = tag.name

.prose.max-w-none.mb-8
  = @project.body

hr.my-8

h2.text-xl.font-semibold.mb-4 Project Image

= turbo_frame_tag "project_images_#{@project.id}" do
  - if @project.project_images.any?
    - @project.project_images.each do |project_image|
      = render "creator/project_images/project_image", project: @project, project_image: project_image
  - else
    p.text-gray-500.text-sm.mb-4 No image yet. Upload one to start annotating hotspots.

  .mt-4
    h3.text-sm.font-medium.text-gray-700.mb-2 Upload Image
    = render "creator/project_images/upload_form", project: @project
