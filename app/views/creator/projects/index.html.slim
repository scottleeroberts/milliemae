- content_for :title, "My Projects — Sew Twirly"

.grid.grid-cols-3.gap-4.mb-6
  .bg-gray-50.border.rounded-lg.p-3.text-center
    p.text-2xl.font-bold = @published_count
    p.text-xs.text-gray-500.mt-1 Published projects
  .bg-gray-50.border.rounded-lg.p-3.text-center
    p.text-2xl.font-bold = @total_likes
    p.text-xs.text-gray-500.mt-1 Total likes
  .bg-gray-50.border.rounded-lg.p-3.text-center
    p.text-2xl.font-bold = @follower_count
    p.text-xs.text-gray-500.mt-1 Followers

.flex.items-center.justify-between.mb-6
  h1.text-2xl.font-bold My Projects
  = link_to "New Project", new_creator_project_path, class: "bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700"

- if @projects.empty?
  p.text-gray-500 You haven't created any projects yet.

- else
  .space-y-4
    - @projects.each do |project|
      .border.rounded-lg.p-4.flex.items-start.justify-between
        div
          h2.font-semibold.text-lg = link_to project.title, creator_project_path(project), class: "hover:underline"
          p.text-sm.text-gray-500.mt-1
            - if project.published?
              span.text-green-600 Published
              span.text-gray-500 ·
              = project.published_date
            - else
              span.text-yellow-600 Draft
          - if project.tags.any?
            p.text-sm.text-gray-500.mt-1 = project.tags.map(&:name).join(", ")
        .flex.items-center.gap-2.mt-1
          = link_to "Edit", edit_creator_project_path(project), class: "text-sm text-blue-600 hover:underline"
          - if project.published?
            = button_to "Unpublish", unpublish_creator_project_path(project), method: :patch, class: "text-sm text-yellow-600 hover:underline bg-transparent border-0 p-0 cursor-pointer"
          - else
            = button_to "Publish", publish_creator_project_path(project), method: :patch, class: "text-sm text-green-600 hover:underline bg-transparent border-0 p-0 cursor-pointer"
          = button_to "Delete", creator_project_path(project), method: :delete, data: { turbo_confirm: "Delete \"#{project.title}\"? This cannot be undone." }, class: "text-sm text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer"
