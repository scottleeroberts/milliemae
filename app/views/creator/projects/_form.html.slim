= form_with model: [:creator, project], class: "space-y-6" do |f|
  - if project.errors.any?
    .bg-red-50.border.border-red-200.rounded.p-4
      p.font-semibold.text-red-800.mb-2 = pluralize(project.errors.count, "error") + " prevented this project from being saved:"
      ul.list-disc.list-inside.text-red-700
        - project.errors.full_messages.each do |msg|
          li = msg

  div
    = f.label :title, class: "block text-sm font-medium text-gray-700 mb-1"
    = f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400", placeholder: "My beautiful dress"

  div
    = f.label :body, class: "block text-sm font-medium text-gray-700 mb-1"
    = f.rich_text_area :body, class: "w-full"

  div
    = f.label :tag_list, "Tags", class: "block text-sm font-medium text-gray-700 mb-1"
    = f.text_field :tag_list, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400", placeholder: "cotton, sundress, simplicity"
    p.text-xs.text-gray-500.mt-1 Separate tags with commas

  .flex.items-center.gap-3
    = f.submit project.persisted? ? "Update Project" : "Create Project", class: "bg-pink-600 text-white px-6 py-2 rounded hover:bg-pink-700 cursor-pointer"
    = link_to "Cancel", project.persisted? ? creator_project_path(project) : creator_projects_path, class: "text-sm text-gray-500 hover:underline"
