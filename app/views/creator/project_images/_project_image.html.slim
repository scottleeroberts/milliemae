= turbo_frame_tag "project_image_#{project_image.id}" do
  .mb-8 data-controller="hotspot-annotator"
    .relative.inline-block.max-w-full
      = image_tag project_image.image, class: "block max-w-full", data: { hotspot_annotator_target: "image", action: "click->hotspot-annotator#placeHotspot" }

      - project_image.product_links.each.with_index(1) do |pl, idx|
        a.absolute.flex.items-center.justify-center.bg-red-500.text-white.text-xs.font-bold.rounded-full.w-6.h-6.shadow-lg.-translate-x-3.-translate-y-3 href=pl.url target="_blank" title=pl.label style="left: #{(pl.x * 100).round(2)}%; top: #{(pl.y * 100).round(2)}%;"
          = idx

      - annotation_product_link = local_assigns.fetch(:errored_product_link, nil)
      - form_hidden_class = annotation_product_link&.errors&.any? ? "" : "hidden"
      .absolute.bg-white.shadow-xl.rounded.p-4.z-20.w-72 class=form_hidden_class data-hotspot-annotator-target="annotationForm" style="transform: translate(8px, 8px);"
        - if annotation_product_link&.errors&.any?
          .bg-red-50.border.border-red-200.rounded.p-2.mb-3
            - annotation_product_link.errors.full_messages.each do |msg|
              p.text-xs.text-red-700 = msg
        = form_with model: (annotation_product_link || project_image.product_links.build), url: creator_project_project_image_product_links_path(project, project_image) do |f|
          = f.hidden_field :x, data: { hotspot_annotator_target: "xInput" }
          = f.hidden_field :y, data: { hotspot_annotator_target: "yInput" }
          div
            = f.label :label, "Product name", class: "block text-xs font-medium text-gray-700 mb-1"
            = f.text_field :label, class: "w-full border border-gray-300 rounded px-2 py-1 text-sm", placeholder: "e.g. Simplicity 1234", autofocus: true
          div.mt-2
            = f.label :url, "Link URL", class: "block text-xs font-medium text-gray-700 mb-1"
            = f.text_field :url, class: "w-full border border-gray-300 rounded px-2 py-1 text-sm", placeholder: "https://..."
          .flex.gap-2.mt-3
            = f.submit "Save", class: "bg-pink-500 text-white text-xs px-3 py-1.5 rounded cursor-pointer hover:bg-pink-600"
            button.text-xs.text-gray-500.hover:underline type="button" data-action="hotspot-annotator#cancelAnnotating" Cancel

    .mt-3.flex.items-center.gap-4
      button.text-sm.text-pink-600.hover:underline type="button" data-action="hotspot-annotator#startAnnotating"
        | + Add hotspot
      = button_to "Remove image", creator_project_project_image_path(project, project_image), method: :delete, data: { turbo_confirm: "Remove this image and all its hotspots?" }, class: "text-sm text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer"

    - persisted_links = project_image.product_links.to_a.select(&:persisted?)
    - if persisted_links.any?
      .mt-4
        h4.text-sm.font-medium.text-gray-700.mb-2
          | Hotspots (#{persisted_links.size})
        ul.space-y-2
          - persisted_links.each.with_index(1) do |pl, idx|
            li.flex.items-center.justify-between.text-sm id="product_link_#{pl.id}"
              .flex.items-center.gap-2.min-w-0
                span.flex.items-center.justify-center.bg-red-500.text-white.text-xs.font-bold.rounded-full.w-5.h-5.shrink-0 = idx
                = link_to pl.label, pl.url, class: "text-blue-600 hover:underline truncate", target: "_blank"
              = button_to "Remove", creator_project_project_image_product_link_path(project, project_image, pl), method: :delete, data: { turbo_confirm: "Remove \"#{pl.label}\"?" }, class: "text-xs text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer"
