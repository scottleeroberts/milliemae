.max-w-md.mx-auto
  h2.text-2xl.font-bold.text-center.mb-8 Sign up

  = form_for resource, as: resource_name, url: registration_path(resource_name) do |f|
    = render "devise/shared/error_messages", resource: resource

    .mb-4
      = f.label :name, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.text_field :name, autofocus: true, autocomplete: "name", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :email, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.email_field :email, autocomplete: "email", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :password, class: "block text-sm font-medium text-gray-700 mb-1"
      - if @minimum_password_length
        p.text-xs.text-gray-500.mb-1 = "#{@minimum_password_length} characters minimum"
      = f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.submit "Sign up", class: "w-full bg-pink-500 text-white py-2 px-4 rounded hover:bg-pink-600 cursor-pointer"

  = render "devise/shared/links"
