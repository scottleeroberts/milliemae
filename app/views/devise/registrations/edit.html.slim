.max-w-md.mx-auto
  h2.text-2xl.font-bold.text-center.mb-8 Edit account

  = form_for resource, as: resource_name, url: registration_path(resource_name), html: { method: :put } do |f|
    = render "devise/shared/error_messages", resource: resource

    .mb-4
      = f.label :name, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.text_field :name, autocomplete: "name", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :bio, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.text_area :bio, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :email, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.email_field :email, autocomplete: "email", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-6
      = f.label :password, class: "block text-sm font-medium text-gray-700 mb-1"
      span.text-xs.text-gray-500 Leave blank if you don't want to change it
      = f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-6
      = f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1"
      span.text-xs.text-gray-500 We need your current password to confirm changes
      = f.password_field :current_password, autocomplete: "current-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    - if resource.creator_access?
      .mb-6.border.border-gray-200.rounded.p-4
        h3.text-sm.font-semibold.text-gray-700.mb-3 Creator Links
        .mb-3
          = f.label :instagram, class: "block text-sm font-medium text-gray-700 mb-1"
          = f.url_field :instagram, placeholder: "https://instagram.com/yourname", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
        .mb-3
          = f.label :etsy, class: "block text-sm font-medium text-gray-700 mb-1"
          = f.url_field :etsy, placeholder: "https://etsy.com/shop/yourshop", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
        .mb-3
          = f.label :pinterest, class: "block text-sm font-medium text-gray-700 mb-1"
          = f.url_field :pinterest, placeholder: "https://pinterest.com/yourname", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
        .mb-3
          = f.label :website, class: "block text-sm font-medium text-gray-700 mb-1"
          = f.url_field :website, placeholder: "https://yourwebsite.com", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
        .mb-0
          = f.label :facebook, class: "block text-sm font-medium text-gray-700 mb-1"
          = f.url_field :facebook, placeholder: "https://facebook.com/yourpage", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.submit "Update", class: "w-full bg-pink-600 text-white py-2 px-4 rounded hover:bg-pink-700 cursor-pointer"

  hr.my-8

  h3.text-lg.font-semibold.text-red-600.mb-2 Cancel my account
  p.text-sm.text-gray-600.mb-4 This will permanently delete your account.
  = button_to "Cancel my account", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-500 text-white py-2 px-4 rounded hover:bg-red-600 cursor-pointer"
