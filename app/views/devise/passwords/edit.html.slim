.max-w-md.mx-auto
  h2.text-2xl.font-bold.text-center.mb-8 Change your password

  = form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :put } do |f|
    = render "devise/shared/error_messages", resource: resource
    = f.hidden_field :reset_password_token

    .mb-4
      = f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1"
      - if @minimum_password_length
        p.text-xs.text-gray-500.mb-1 = "#{@minimum_password_length} characters minimum"
      = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"

    .mb-4
      = f.submit "Change my password", class: "w-full bg-pink-500 text-white py-2 px-4 rounded hover:bg-pink-600 cursor-pointer"

  = render "devise/shared/links"
