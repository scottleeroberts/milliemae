.mt-6.text-center.text-sm.text-gray-600.space-y-2
  - if controller_name != "sessions"
    p = link_to "Log in", new_session_path(resource_name), class: "text-pink-600 hover:text-pink-800"

  - if devise_mapping.registerable? && controller_name != "registrations"
    p = link_to "Sign up", new_registration_path(resource_name), class: "text-pink-600 hover:text-pink-800"

  - if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations"
    p = link_to "Forgot your password?", new_password_path(resource_name), class: "text-pink-600 hover:text-pink-800"
