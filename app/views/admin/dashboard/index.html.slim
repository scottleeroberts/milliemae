- content_for :title, "Admin Dashboard — Sew Twirly"

.flex.items-center.justify-between.mb-6
  h1.text-2xl.font-bold Admin Dashboard
  .flex.gap-3
    = link_to "Invitations", admin_invitations_path, class: "text-sm text-pink-600 hover:underline"
    = link_to "Users", admin_users_path, class: "text-sm text-pink-600 hover:underline"
    = link_to "Projects", admin_projects_path, class: "text-sm text-pink-600 hover:underline"

.grid.grid-cols-2.gap-4.md:grid-cols-3.lg:grid-cols-6.mb-8
  .bg-white.border.rounded-lg.p-4.text-center
    p.text-3xl.font-bold = @audience_count
    p.text-xs.text-gray-500.mt-1 Audience
  .bg-white.border.rounded-lg.p-4.text-center
    p.text-3xl.font-bold = @creator_count
    p.text-xs.text-gray-500.mt-1 Creators
  .bg-white.border.rounded-lg.p-4.text-center
    p.text-3xl.font-bold = @admin_count
    p.text-xs.text-gray-500.mt-1 Admins
  .bg-white.border.rounded-lg.p-4.text-center
    p.text-3xl.font-bold = @published_projects_count
    p.text-xs.text-gray-500.mt-1 Published
  .bg-white.border.rounded-lg.p-4.text-center
    p.text-3xl.font-bold = @draft_projects_count
    p.text-xs.text-gray-500.mt-1 Drafts
  .bg-white.border.rounded-lg.p-4.text-center
    p.text-3xl.font-bold = @pending_invitations_count
    p.text-xs.text-gray-500.mt-1 Pending Invites

section
  h2.text-lg.font-semibold.mb-3 Recent Comments
  - if @recent_comments.empty?
    p.text-gray-500 No comments yet.
  - else
    .space-y-2
      - @recent_comments.each do |comment|
        .border.rounded.p-3.flex.items-start.justify-between.gap-4
          div.min-w-0
            p.text-sm.truncate = comment.body
            p.text-xs.text-gray-500.mt-1
              | by
              = " #{comment.user.display_name}"
              |  on "#{comment.project.title}" —
              = " #{time_ago_in_words(comment.created_at)} ago"
          = button_to "Delete", project_comment_path(comment.project, comment), method: :delete, data: { turbo_confirm: "Delete this comment?" }, class: "text-xs text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer shrink-0"
