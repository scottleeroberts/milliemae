doctype html
html
  head
    title = yield(:title).presence || "Sew Twirly"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Sew Twirly"
    meta name="description" content=(yield(:description).presence || "Discover handmade sewing projects with shoppable product links on Sew Twirly.")
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Quicksand:wght@400;500;600&display=swap"
    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/icon.png"
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = stylesheet_link_tag "actiontext"
    = javascript_importmap_tags

  body.bg-stone-50.text-gray-900
    a.sr-only.focus:not-sr-only.focus:absolute.focus:z-50.focus:p-4.focus:bg-pink-600.focus:text-white.focus:font-medium href="#main-content" Skip to content
    nav.bg-white.shadow.border-b-2.border-pink-200 aria-label="Main navigation"
      .container.mx-auto.px-4.py-3.flex.items-center.justify-between
        = link_to "Sew Twirly", root_path, class: "text-2xl font-bold font-display text-pink-600 hover:text-pink-700 transition-colors"
        .flex.items-center.gap-4
          = link_to "About", about_path, class: "text-sm text-gray-600 hover:text-pink-600"
          - if user_signed_in?
            - if current_user.admin?
              = link_to "Admin", admin_root_path, class: "text-sm text-pink-600 font-medium hover:text-pink-800"
            - if current_user.creator? || current_user.admin?
              = link_to "My Projects", creator_projects_path, class: "text-sm text-gray-600 hover:text-gray-900"
            = link_to current_user.display_name, creator_path(current_user), class: "text-sm text-gray-600 hover:text-gray-900"
            = link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-gray-600 hover:text-gray-900"
          - else
            = link_to "Sign in", new_user_session_path, class: "text-sm text-gray-600 hover:text-gray-900"
            = link_to "Sign up", new_user_registration_path, class: "text-sm bg-pink-600 text-white px-3 py-1 rounded hover:bg-pink-700"

    - if notice.present?
      .container.mx-auto.px-4.mt-4 data-controller="flash"
        .bg-green-100.text-green-800.p-3.rounded.flex.items-center.justify-between role="alert"
          span = notice
          button.text-green-600.hover:text-green-800.text-lg.font-bold.leading-none.ml-4 type="button" data-action="flash#close" aria-label="Dismiss" ×
    - if alert.present?
      .container.mx-auto.px-4.mt-4 data-controller="flash"
        .bg-red-100.text-red-800.p-3.rounded.flex.items-center.justify-between role="alert"
          span = alert
          button.text-red-600.hover:text-red-800.text-lg.font-bold.leading-none.ml-4 type="button" data-action="flash#close" aria-label="Dismiss" ×

    main.container.mx-auto.px-4.mt-8 id="main-content"
      = yield

    = render "layouts/footer"
