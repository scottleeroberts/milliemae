div id=dom_id(creator, :follow) class="flex items-center gap-3"
  span.text-sm.text-gray-500 = pluralize(creator.followers.size, "follower")
  - if user_signed_in? && current_user != creator
    - if current_user.following?(creator)
      = button_to creator_follow_path(creator), method: :delete, class: "px-4 py-1.5 border border-pink-600 text-pink-600 hover:bg-pink-50 text-sm font-medium rounded transition-colors"
        | Following
    - else
      = button_to creator_follow_path(creator), method: :post, class: "px-4 py-1.5 bg-pink-600 text-white hover:bg-pink-700 text-sm font-medium rounded transition-colors"
        | Follow
