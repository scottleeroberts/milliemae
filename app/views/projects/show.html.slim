- content_for :title, "#{@project.title} — Sew Twirly"
- content_for :description, "#{@project.title} by #{@project.user.display_name} on Sew Twirly."
- content_for :head do
  meta property="og:title" content=("#{@project.title} — Sew Twirly")
  meta property="og:type" content="article"
  meta property="og:description" content=("#{@project.title} by #{@project.user.display_name} on Sew Twirly.")
  meta property="og:url" content=project_url(@project)
  meta name="twitter:card" content="summary_large_image"
  - if @project.cover_image&.image&.attached?
    meta property="og:image" content=url_for(@project.cover_image.image)

.bg-rose-50.rounded-xl.p-4.sm:p-6.mb-8.-mx-4
  .mb-4
    = link_to "← All Projects", projects_path, class: "text-sm text-gray-500 hover:underline"

  .flex.flex-col.sm:flex-row.sm:items-start.sm:justify-between.gap-4
    div
      h1.text-2xl.sm:text-3xl.font-bold.leading-tight = @project.title

      .flex.items-center.gap-2.mt-2.mb-4
        span.text-sm.text-gray-500 = published_date(@project)

      - if @project.tags.any?
        .flex.flex-wrap.gap-2.mb-4
          - @project.tags.each do |tag|
            = link_to tag.name, projects_path(tag: tag.name), class: "bg-teal-50 text-teal-700 text-xs px-2 py-1 rounded-full hover:bg-pink-100 hover:text-pink-600"

      = render "likes/button", project: @project

    .flex.flex-col.items-center.shrink-0
      = link_to creator_path(@project.user) do
        img.w-16.h-16.rounded-full.shadow src=@project.user.gravatar_url(size: 128) alt="#{@project.user.display_name}'s avatar"
      = link_to @project.user.display_name, creator_path(@project.user), class: "text-sm font-medium text-gray-700 hover:text-pink-600 mt-2"
      - social = @project.user.social_links
      - if social.any?
        .flex.flex-wrap.gap-2.mt-1
          - social.each do |label, url|
            = link_to label, url, target: "_blank", rel: "noopener noreferrer", class: "text-xs text-pink-600 hover:text-pink-700"

- if @project.body.present?
  .prose.max-w-none.mb-10
    = @project.body

- if @project.project_images.any?
  .space-y-10
    - @project.project_images.each do |project_image|
      = render "hotspot_image", project_image: project_image, image_alt: @project.title

section.mt-12
  h2.text-xl.font-semibold.mb-4 Comments
  - if user_signed_in?
    .mb-6
      = render "comments/form", project: @project, comment: Comment.new
  - else
    p.text-sm.text-gray-500.mb-6
      | = link_to "Sign in", new_user_session_path, class: "text-pink-600 hover:underline"
      |  to leave a comment.
  div id=dom_id(@project, :comments) class="space-y-4 divide-y divide-gray-100"
    - @project.comments.includes(:user).each do |comment|
      .py-3
        = render "comments/comment", comment: comment, project: @project
