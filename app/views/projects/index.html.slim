- content_for :title, "Discover Projects — Sew Twirly"
- content_for :description, "Browse handmade sewing projects from talented makers on Sew Twirly."

/ Hero section
.bg-rose-50.rounded-xl.p-8.mb-8.-mx-4.text-center
  h1.text-2xl.sm:text-4xl.font-bold.text-gray-900.mb-3 Discover Handmade Creations
  p.text-gray-600.max-w-xl.mx-auto Explore sewing projects from talented makers — each one featuring shoppable product links so you can recreate the look.

/ Popular tags bar
- if @popular_tags.any? && @tag.blank?
  .overflow-x-auto.pb-2.-mx-4.px-4.sm:mx-0.sm:px-0
    .flex.sm:flex-wrap.sm:justify-center.gap-2.mb-8
      - @popular_tags.each do |tag|
        = link_to tag.name, projects_path(tag: tag.name), class: "whitespace-nowrap bg-teal-50 text-teal-700 text-sm px-3 py-1 rounded-full border border-teal-100 hover:bg-pink-100 hover:text-pink-600 hover:border-pink-200 transition-colors"

/ Active tag filter
- if @tag.present?
  .flex.items-center.gap-2.mb-6
    span.text-sm.text-gray-600 Showing:
    span.bg-teal-100.text-teal-700.text-sm.font-medium.px-3.py-1.rounded-full = @tag
    = link_to "Clear", projects_path, class: "text-xs text-gray-500 hover:underline"

/ Project grid
- if @projects.any?
  .grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3.gap-6
    - @projects.each do |project|
      = render "card", project: project
- else
  .text-center.py-16
    p.text-gray-500.text-lg.mb-4 No projects published yet. Check back soon!
    - if user_signed_in? && (current_user.creator? || current_user.admin?)
      = link_to "Create a project", new_creator_project_path, class: "text-pink-600 font-medium hover:underline"

/ Pagination
- if @total_pages > 1
  .flex.items-center.justify-center.gap-4.mt-10
    - if @page > 1
      = link_to "← Previous", projects_path(page: @page - 1, tag: @tag), class: "text-sm text-pink-600 hover:underline"
    span.text-sm.text-gray-500 Page #{@page} of #{@total_pages}
    - if @page < @total_pages
      = link_to "Next →", projects_path(page: @page + 1, tag: @tag), class: "text-sm text-pink-600 hover:underline"
