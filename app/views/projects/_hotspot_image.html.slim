/ Read-only hotspot image with click-to-reveal tooltips.
/ Side-by-side layout: flatlay image (left) + shopping list card (right)
.mb-10
  - has_products = project_image.product_links.any?
  div class=(has_products ? "grid grid-cols-1 lg:grid-cols-3 gap-6 items-start" : "")
    - tooltip_id = "project_image_#{project_image.id}_tooltip"
    .relative.lg:col-span-2 data-controller="hotspot-tooltip" data-hotspot-tooltip-hidden-class="hidden"
      - if project_image.image.variable?
        - small_url = url_for(project_image.image.variant(resize_to_limit: [800, 600]))
        - large_url = url_for(project_image.image.variant(resize_to_limit: [1600, 1200]))
        = image_tag(project_image.image.variant(resize_to_limit: [1600, 1200]),
            class: "block w-full rounded-lg shadow",
            alt: local_assigns.fetch(:image_alt, ""),
            loading: "lazy",
            srcset: "#{small_url} 800w, #{large_url} 1600w",
            sizes: "(max-width: 768px) 100vw, 66vw",
            width: project_image.image_width.presence,
            height: project_image.image_height.presence)
      - else
        = image_tag(project_image.image,
            class: "block w-full rounded-lg shadow",
            alt: local_assigns.fetch(:image_alt, ""),
            loading: "lazy",
            width: project_image.image_width.presence,
            height: project_image.image_height.presence)

      - project_image.product_links.each.with_index(1) do |pl, idx|
        button.hotspot-pin.animate-hotspot-pulse.cursor-pointer type="button" aria-label="Product #{idx}: #{pl.label}" aria-controls=tooltip_id aria-expanded="false" style="left: #{(pl.x * 100).round(2)}%; top: #{(pl.y * 100).round(2)}%;" data-action="hotspot-tooltip#toggle" data-hotspot-tooltip-target="pin" data-label=pl.label data-url=pl.url
          = idx

      / Tooltip (hidden by default, positioned by Stimulus controller)
      .hidden.absolute.bg-white.rounded-lg.shadow-xl.p-3.z-10.min-w-48 id=tooltip_id role="dialog" aria-label="Product details" aria-hidden="true" data-hotspot-tooltip-target="tooltip"
        p.font-medium.text-sm.text-gray-900 data-hotspot-tooltip-target="tooltipLabel"
        a.text-pink-600.text-sm.font-medium.hover:underline.mt-1.inline-block href="#" target="_blank" rel="noopener noreferrer" data-hotspot-tooltip-target="tooltipLink"
          | Shop →

    - if has_products
      .bg-white.rounded-xl.shadow-md.p-5.lg:col-span-1
        h3.font-display.text-lg.font-semibold.text-pink-600.mb-4 Shopping List
        ol.space-y-3
          - project_image.product_links.each.with_index(1) do |pl, idx|
            li
              = link_to pl.url, class: "flex items-center gap-3 group/item", target: "_blank", rel: "noopener noreferrer"
                span class="hotspot-pin-index hotspot-pin-index--list group-hover/item:bg-pink-700 transition-colors" = idx
                span class="text-sm text-gray-700 group-hover/item:text-pink-600 transition-colors" = pl.label
