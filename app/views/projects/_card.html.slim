article.group.bg-white.rounded-3xl.shadow-md.overflow-hidden.flex.flex-col.hover:-translate-y-1.hover:shadow-xl.transition-all.duration-300
  - cover = project.cover_image
  - if cover&.image&.attached?
    = link_to project_path(project), class: "block overflow-hidden"
      = image_tag cover.image, class: "w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300", alt: project.title
  - else
    .w-full.h-64.bg-gray-100.flex.items-center.justify-center
      span.text-gray-300.text-sm No image yet

  .p-5.flex.flex-col.flex-1
    h2.font-semibold.text-lg.leading-snug
      = link_to project.title, project_path(project), class: "text-gray-900 hover:text-pink-600 transition-colors"

    .flex.items-center.gap-2.mt-2
      img.w-5.h-5.rounded-full src=project.user.gravatar_url(size: 40) alt=""
      span.text-xs.text-gray-400 by
      = link_to project.user.display_name, creator_path(project.user), class: "text-xs text-gray-600 font-medium hover:underline"

    - if project.body.present?
      p.text-sm.text-gray-500.mt-2.line-clamp-2 = project.body.to_plain_text.truncate(120)

    - if project.tags.any?
      .flex.flex-wrap.gap-1.mt-3
        - project.tags.each do |tag|
          = link_to tag.name, projects_path(tag: tag.name), class: "bg-teal-50 text-teal-700 text-xs px-2 py-0.5 rounded-full hover:bg-pink-100 hover:text-pink-600 transition-colors"

    .flex.items-center.gap-4.mt-auto.pt-4.border-t.border-gray-50
      span.text-xs.text-gray-400.flex.items-center.gap-1
        span ♥
        = project.likes.size
      span.text-xs.text-gray-400.flex.items-center.gap-1
        span 💬
        = project.comments.size
      span.text-xs.text-gray-300.ml-auto = project.published_date
