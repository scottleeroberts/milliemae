div id=dom_id(project, :like) class="flex items-center gap-3"
  span.text-sm.text-gray-500 = pluralize(project.likes.size, "like")
  - if user_signed_in?
    - if current_user.liked?(project)
      = button_to project_like_path(project), method: :delete, class: "py-2.5 px-3 text-pink-600 hover:text-pink-700 text-sm font-medium transition-all active:scale-125"
        | ♥ Unlike
    - else
      = button_to project_like_path(project), method: :post, class: "py-2.5 px-3 text-gray-500 hover:text-pink-600 text-sm font-medium transition-all active:scale-125"
        | ♥ Like
  - else
    = link_to new_user_session_path, class: "text-gray-500 hover:text-pink-600 text-sm font-medium"
      | ♥ Like
